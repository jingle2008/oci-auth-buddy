{
  "name": "OCI Auth Buddy",
  "description": "Automates Oracle Cloud authentication tasks.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["scripting", "tabs", "storage"],
  "content_scripts": [
    {
      "matches": ["https://login.oci.oraclecloud.com/*"],
      "js": ["helper.js", "scripts/login-1-account.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://login.us-ashburn-1.oraclecloud.com/*"],
      "js": ["helper.js", "scripts/login-2-sso.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://signon-int.oracle.com/signin*", "https://signon.oci.oracleiaas.com/signin*"],
      "js": ["helper.js", "scripts/login-3-mfa.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:8181/*"],
      "js": ["helper.js", "scripts/login-complete.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.oracle.com/cloud/sign-in.html*"],
      "js": ["helper.js", "scripts/console-login.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cloud.oracle.com/*"],
      "js": ["helper.js", "scripts/console-home.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "https://login.oci.oraclecloud.com/*",
    "https://login.us-ashburn-1.oraclecloud.com/*",
    "https://signon-int.oracle.com/signin*",
    "https://signon.oci.oracleiaas.com/signin*",
    "http://localhost:8181/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "View OCI Auth Buddy Logs"
  }
}
